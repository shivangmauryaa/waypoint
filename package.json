{
  "name": "waypoint-recovery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "dev:mobile": "vite build --config vite.mobile.config.js --configLoader runner && concurrently -k \"node --env-file-if-exists=.env --watch server/index.js\" \"vite build --config vite.mobile.config.js --configLoader runner --watch\" \"node mobile/serve.js\"",
    "mobile:build": "vite build --config vite.mobile.config.js --configLoader runner",
    "build": "vite build --configLoader runner",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "vitest run tests/ui.test.jsx --environment jsdom",
    "start:network": "node --env-file=.env.network server/index.js",
    "start:tunnel": "node --env-file=.env.tunnel server/index.js"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.8.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.0.10",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.169.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
